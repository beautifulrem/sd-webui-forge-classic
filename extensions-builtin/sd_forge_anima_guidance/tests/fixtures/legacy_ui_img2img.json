{
 "script": "AnimaGuidanceScript",
 "title": "Anima Guidance & Corrections",
 "tab": "img2img",
 "shown": true,
 "inputs": [
  {
   "type": "toggle",
   "label": "Anima Guidance & Corrections",
   "default": false,
   "infotext": "Anima guidance enabled",
   "preset": "guidance.enabled",
   "info": null,
   "legacy_control": "Checkbox",
   "visible": false
  },
  {
   "type": "choice",
   "label": "CFG guidance mode",
   "default": "Standard / preserve existing",
   "choices": [
    "Standard / preserve existing",
    "SMC-CFG",
    "CFG-Zero*",
    "APG",
    "TCFG",
    "FDG (experimental)"
   ],
   "style": "dropdown",
   "infotext": "Anima CFG guidance mode",
   "preset": "guidance.mode",
   "info": "SMC-CFG, CFG-Zero*, APG, TCFG and FDG are mutually exclusive combine modes. Skimmed CFG is applied before the selected combine. TCFG has no settings: it drops the part of the negative prediction that does not lie along the direction it shares with the positive one.",
   "legacy_control": "Dropdown",
   "visible": true
  },
  {
   "type": "slider",
   "label": "SMC adaptive alpha",
   "default": 0.2,
   "minimum": 0.0,
   "maximum": 1.0,
   "step": 0.01,
   "integer": false,
   "infotext": "Anima SMC alpha",
   "preset": "guidance.smc_alpha",
   "info": "Switching gain = alpha x mean absolute conditional residual.",
   "legacy_control": "Slider",
   "visible": true
  },
  {
   "type": "slider",
   "label": "SMC surface lambda",
   "default": 5.0,
   "minimum": 0.0,
   "maximum": 10.0,
   "step": 0.1,
   "integer": false,
   "infotext": "Anima SMC lambda",
   "preset": "guidance.smc_lambda",
   "info": null,
   "legacy_control": "Slider",
   "visible": true
  },
  {
   "type": "toggle",
   "label": "Skimmed CFG anti-burn",
   "default": false,
   "infotext": "Anima Skimmed CFG",
   "preset": "guidance.skim_enabled",
   "info": null,
   "legacy_control": "Checkbox",
   "visible": true
  },
  {
   "type": "slider",
   "label": "Skimming fallback CFG",
   "default": 2.5,
   "minimum": 0.0,
   "maximum": 10.0,
   "step": 0.1,
   "integer": false,
   "infotext": "Anima skim CFG",
   "preset": "guidance.skim_scale",
   "info": "Only flagged values are limited to this effective CFG; 1.5–3 is a useful Anima range.",
   "legacy_control": "Slider",
   "visible": true
  },
  {
   "type": "toggle",
   "label": "Full skim negative",
   "default": false,
   "infotext": "Anima skim full negative",
   "preset": "guidance.skim_full_negative",
   "info": "Uses a zero fallback for flagged negative-prompt values.",
   "legacy_control": "Checkbox",
   "visible": true
  },
  {
   "type": "toggle",
   "label": "Disable flipping filter",
   "default": false,
   "infotext": "Anima skim disable flip filter",
   "preset": "guidance.skim_disable_flip",
   "info": "More aggressive; keeps values normally rejected by the sign-flip safety filter.",
   "legacy_control": "Checkbox",
   "visible": true
  },
  {
   "type": "slider",
   "label": "Skim start",
   "default": 0.0,
   "minimum": 0.0,
   "maximum": 1.0,
   "step": 0.01,
   "integer": false,
   "infotext": "Anima skim start",
   "preset": "guidance.skim_start",
   "info": "Fraction of model (sigma) time, not of the step count: with Anima's shift 3, 0.5 is sigma 0.75, so the steps a window covers depend on the scheduler.",
   "legacy_control": "Slider",
   "visible": true
  },
  {
   "type": "slider",
   "label": "Skim end",
   "default": 1.0,
   "minimum": 0.0,
   "maximum": 1.0,
   "step": 0.01,
   "integer": false,
   "infotext": "Anima skim end",
   "preset": "guidance.skim_end",
   "info": "Fraction of model (sigma) time, not of the step count: with Anima's shift 3, 0.5 is sigma 0.75, so the steps a window covers depend on the scheduler.",
   "legacy_control": "Slider",
   "visible": true
  },
  {
   "type": "slider",
