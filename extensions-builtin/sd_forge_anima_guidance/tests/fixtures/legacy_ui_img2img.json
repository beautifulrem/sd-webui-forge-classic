   "default": 0.0,
   "minimum": 0.0,
   "maximum": 1.0,
   "step": 0.01,
   "integer": false,
   "infotext": "Anima skim flip",
   "preset": "guidance.skim_flip",
   "info": "0 disables timed inversion of the flipping filter. A model (sigma) time fraction, like Skim start/end.",
   "legacy_control": "Slider",
   "visible": true
  },
  {
   "type": "toggle",
   "label": "Enable DCW",
