  {
   "id": "seed",
   "title": "Seed",
   "kind": "alwayson",
   "section": "seed",
   "order": 0,
   "layout": {
    "type": "group",
    "open": true,
    "children": [
     {
      "type": "row",
      "children": [
       {
        "type": "seed",
        "name": "seed",
        "label": "Seed",
        "hint": "Given the same prompts and parameters, you \"should\" generate the same image if the Seed is also the same",
        "default": -1,
        "infotext": "Seed"
       },
       {
        "type": "toggle",
        "name": "subseed_show",
        "label": "Extra",
        "default": false,
        "width": "auto"
       }
      ]
     },
     {
      "type": "group",
      "open": true,
      "children": [
       {
        "type": "row",
        "children": [
