       },
       {
        "type": "row",
        "children": [
         {
          "type": "slider",
          "name": "seed_resize_from_w",
          "label": "Resize seed from width",
          "default": 0,
          "minimum": 0,
          "maximum": 2048,
          "step": 8,
          "integer": true,
          "infotext": "Seed resize from-1"
         },
         {
          "type": "slider",
          "name": "seed_resize_from_h",
          "label": "Resize seed from height",
          "default": 0,
          "minimum": 0,
          "maximum": 2048,
          "step": 8,
          "integer": true,
          "infotext": "Seed resize from-2"
         }
        ]
       }
      ],
      "visible_if": {
       "param": "subseed_show"
      }
     }
    ]
   },
   "defaults": {
    "seed": -1,
    "subseed_show": false,
    "subseed": -1,
    "subseed_strength": 0.0,
    "seed_resize_from_w": 0,
    "seed_resize_from_h": 0
