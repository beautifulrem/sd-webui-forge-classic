          "infotext": "Variation seed"
         },
         {
          "type": "slider",
          "name": "subseed_strength",
          "label": "Variation strength",
          "default": 0.0,
          "minimum": 0,
          "maximum": 1,
          "step": 0.01,
          "integer": false,
          "infotext": "Variation seed strength"
         }
