         "allow_custom": false,
         "infotext": "Mask mode"
        },
        {
         "type": "choice",
         "name": "inpainting_fill",
         "label": "Masked content",
         "default": "original",
         "choices": [
          {
           "value": "fill",
           "label": "fill"
          },
          {
           "value": "original",
           "label": "original"
          },
          {
           "value": "latent noise",
           "label": "latent noise"
          },
          {
           "value": "latent nothing",
           "label": "latent nothing"
          }
         ],
         "style": "radio",
         "allow_custom": false,
         "infotext": "Masked content"
        },
        {
         "type": "row",
         "children": [
          {
           "type": "choice",
