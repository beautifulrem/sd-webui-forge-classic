       "choices": [
        {
         "value": "Resize to",
         "label": "Resize to"
        },
        {
         "value": "Resize by",
         "label": "Resize by"
        }
       ],
       "style": "dropdown",
       "allow_custom": false,
       "hidden": true
      },
      {
       "type": "tabs",
       "bind": "resize_tab",
       "children": [
        {
         "type": "tab",
         "title": "Resize to",
         "value": "Resize to",
         "children": [
          {
           "type": "slider",
           "name": "width",
           "label": "Width",
