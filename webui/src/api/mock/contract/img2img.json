        },
        {
         "type": "image",
         "name": "sketch",
         "label": "Sketch",
         "default": null,
         "kind": "sketch",
         "source": "init_img",
         "mode": "RGBA",
         "visible_if": {
          "param": "mode",
          "in": [
           "Sketch",
           "Inpaint sketch"
          ]
         }
        },
        {
         "type": "image",
         "name": "mask",
         "label": "Mask",
         "default": null,
         "kind": "mask",
         "source": "init_img",
         "mode": "RGBA",
         "visible_if": {
          "param": "mode",
          "in": [
           "Inpaint",
           "Inpaint upload"
          ]
         }
        },
        {
         "type": "choice",
         "name": "resize_mode",
         "label": "Resize Mode",
         "default": "Crop and Resize",
         "choices": [
          {
           "value": "Just Resize",
           "label": "Just Resize"
          },
          {
           "value": "Crop and Resize",
           "label": "Crop and Resize"
          },
          {
           "value": "Resize and Fill",
           "label": "Resize and Fill"
          },
          {
           "value": "Latent Upscale",
           "label": "Latent Upscale"
          },
          {
           "value": "Preserve Aspect Ratio",
           "label": "Preserve Aspect Ratio"
          }
         ],
         "style": "radio",
         "allow_custom": false
        }
       ]
      },
      {
       "type": "slot",
       "section": "image"
      }
     ]
    },
    {
     "type": "group",
     "open": true,
     "children": [
