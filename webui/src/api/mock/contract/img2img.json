{
 "version": 1,
 "tab": "img2img",
 "core": {
  "owner": "core",
  "layout": {
   "type": "column",
   "children": [
    {
     "type": "group",
     "open": true,
     "children": [
      {
       "type": "text",
       "name": "prompt",
       "label": "Prompt",
       "default": "",
       "lines": 3,
       "placeholder": "Prompt\n(Ctrl+Enter to Generate ; Alt+Enter to Skip ; Esc to Interrupt)",
       "prompt": true,
       "infotext": "Prompt"
      },
      {
       "type": "text",
       "name": "negative_prompt",
       "label": "Negative Prompt",
       "default": "",
       "lines": 3,
       "placeholder": "Negative Prompt\n(Ctrl+Enter to Generate ; Alt+Enter to Skip ; Esc to Interrupt)",
       "prompt": true,
       "infotext": "Negative prompt",
       "enabled_if": {
        "param": "cfg_scale",
        "gt": 1
       }
      },
      {
       "type": "multichoice",
       "name": "styles",
       "label": "Styles",
       "default": [],
       "choices": [],
       "style": "dropdown",
       "allow_custom": false
      }
     ]
    },
    {
     "type": "group",
     "open": true,
     "children": [
      {
       "type": "group",
       "open": true,
       "children": [
        {
         "type": "choice",
         "name": "mode",
         "label": "Mode",
         "default": "img2img",
         "choices": [
          {
           "value": "img2img",
           "label": "img2img"
          },
          {
           "value": "Sketch",
           "label": "Sketch"
          },
          {
           "value": "Inpaint",
           "label": "Inpaint"
          },
          {
           "value": "Inpaint sketch",
           "label": "Inpaint sketch"
          },
          {
           "value": "Inpaint upload",
           "label": "Inpaint upload"
          },
          {
           "value": "Batch",
           "label": "Batch"
          }
         ],
         "style": "dropdown",
         "allow_custom": false,
         "hidden": true
        },
        {
         "type": "tabs",
         "bind": "mode",
         "children": [
          {
           "type": "tab",
           "title": "img2img",
           "value": "img2img",
           "children": []
          },
          {
           "type": "tab",
           "title": "Sketch",
           "value": "Sketch",
           "children": []
          },
          {
           "type": "tab",
           "title": "Inpaint",
           "value": "Inpaint",
           "children": []
          },
          {
           "type": "tab",
           "title": "Inpaint sketch",
           "value": "Inpaint sketch",
           "children": []
          },
          {
           "type": "tab",
           "title": "Inpaint upload",
           "value": "Inpaint upload",
           "children": []
          },
          {
           "type": "tab",
           "title": "Batch",
           "value": "Batch",
