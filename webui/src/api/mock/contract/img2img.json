            {
             "value": "Whole picture",
             "label": "Whole picture"
            },
            {
             "value": "Only masked",
             "label": "Only masked"
            }
           ],
           "style": "radio",
           "allow_custom": false,
           "infotext": "Inpaint area"
          },
          {
           "type": "slider",
           "name": "inpaint_full_res_padding",
           "label": "Only masked padding, pixels",
           "default": 32,
           "minimum": 0,
           "maximum": 256,
           "step": 8,
           "integer": true,
           "infotext": "Masked area padding"
          }
         ]
        }
       ],
       "visible_if": {
        "param": "mode",
        "in": [
         "Inpaint",
         "Inpaint sketch",
         "Inpaint upload"
        ]
       }
