               ]
              },
              {
               "type": "tab",
               "title": "From directory",
               "value": "from dir",
               "children": [
                {
                 "type": "markdown",
                 "text": "Process images in a directory on the same machine where the server is running.\nUse an empty output directory to save pictures normally instead of writing to the output directory.\nAdd inpaint batch mask directory to enable inpaint batch processing."
                },
                {
                 "type": "text",
                 "name": "batch_input_dir",
                 "label": "Input directory",
                 "default": "",
                 "lines": 1,
                 "prompt": false
                },
                {
                 "type": "text",
                 "name": "batch_output_dir",
                 "label": "Output directory",
                 "default": "",
                 "lines": 1,
                 "prompt": false
                },
                {
                 "type": "text",
                 "name": "batch_inpaint_mask_dir",
                 "label": "Inpaint batch mask directory (required for inpaint batch processing only)",
                 "default": "",
                 "lines": 1,
                 "prompt": false
                }
               ]
              }
             ]
            },
            {
             "type": "section",
             "title": "Append PNG Info",
             "open": false,
             "enable": {
              "type": "toggle",
              "name": "batch_use_png_info",
              "label": "Append PNG Info",
              "default": false
             },
             "children": [
              {
               "type": "text",
               "name": "batch_png_info_dir",
               "label": "PNG info directory",
               "default": "",
               "lines": 1,
               "placeholder": "Leave empty to use input directory",
               "prompt": false
              },
              {
               "type": "multichoice",
               "name": "batch_png_info_props",
               "label": "Parameters to take from png info",
               "info": "Prompts from png info will be appended to prompts set in ui.",
               "default": [],
               "choices": [
                {
                 "value": "Prompt",
                 "label": "Prompt"
                },
                {
                 "value": "Negative prompt",
                 "label": "Negative prompt"
                },
                {
                 "value": "Seed",
                 "label": "Seed"
                },
                {
                 "value": "CFG scale",
                 "label": "CFG scale"
                },
                {
                 "value": "Sampler",
                 "label": "Sampler"
                },
                {
                 "value": "Steps",
                 "label": "Steps"
                },
                {
                 "value": "Model hash",
                 "label": "Model hash"
                },
                {
                 "value": "Filename",
                 "label": "Filename"
                }
               ],
               "style": "checkboxes",
               "allow_custom": false
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "type": "image",
         "name": "init_img",
         "label": "Image",
         "default": null,
         "kind": "image",
         "mode": "RGBA",
