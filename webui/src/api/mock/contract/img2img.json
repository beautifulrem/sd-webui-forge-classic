   "kind": "alwayson",
   "section": "seed",
   "order": 0,
   "legacy": false,
   "layout": {
    "type": "group",
    "open": true,
    "children": [
     {
      "type": "row",
      "children": [
       {
        "type": "seed",
        "name": "seed",
        "label": "Seed",
        "default": -1,
        "infotext": "Seed"
