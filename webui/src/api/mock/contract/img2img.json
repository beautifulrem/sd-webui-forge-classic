           "minimum": 64,
           "maximum": 2048,
           "step": 64,
           "integer": true,
           "infotext": "Size-1"
          },
          {
           "type": "slider",
           "name": "height",
           "label": "Height",
           "default": 1024,
           "minimum": 64,
           "maximum": 2048,
           "step": 64,
           "integer": true,
           "infotext": "Size-2"
