          {
           "type": "button",
           "label": "Switch width/height",
           "action": "swap_dimensions",
           "variant": "tool"
          }
         ]
        },
        {
         "type": "tab",
         "title": "Resize by",
         "value": "Resize by",
         "children": [
          {
           "type": "slider",
           "name": "scale_by",
           "label": "Scale",
           "default": 1.0,
           "minimum": 0.5,
           "maximum": 4.0,
           "step": 0.05,
