            {
             "type": "choice",
             "name": "batch_source",
             "label": "Batch source",
             "default": "upload",
             "choices": [
              {
               "value": "upload",
               "label": "Upload"
              },
              {
               "value": "from dir",
               "label": "From directory"
              }
             ],
             "style": "dropdown",
             "allow_custom": false,
             "hidden": true
            },
            {
             "type": "tabs",
             "bind": "batch_source",
             "children": [
              {
               "type": "tab",
               "title": "Upload",
               "value": "upload",
               "children": [
                {
                 "type": "image_list",
                 "name": "batch_upload",
                 "label": "Files",
                 "default": []
